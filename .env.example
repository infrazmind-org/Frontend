# Production (e.g. https://www.infrazmind.com on Firebase / static host): set to your API base (no trailing slash).
# VITE_API_URL=https://backend-57c5.onrender.com

# Firebase Hosting: see ../docs/FIREBASE_HOSTING.md — multisite deploy from repo root (`npm run deploy:hosting`). Use `.env.production` for builds.

# Local dev: leave VITE_API_URL empty so /api is proxied to the FastAPI process.
VITE_API_URL=

# Local dev only: where to proxy /api (default http://127.0.0.1:8000 — run `uvicorn` from the `api/` folder).
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Admin console is a separate deploy (e.g. https://console.infrazmind.com) with the same VITE_API_URL — see ../admin-app/.env.example.

# Firebase Web SDK (Analytics, future Auth, etc.): copy the **main app** block from ../docs/FIREBASE_WEB_APPS.md into `.env.local` (do not commit `.env.local`).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
